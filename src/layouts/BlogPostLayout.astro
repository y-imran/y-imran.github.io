---
import { getImage, Image } from 'astro:assets';
import BaseLayout from '@src/layouts/BaseLayout.astro';

interface Props {
  title: string;
  pubDate: Date;
  excerpt: string;
  banner: ImageMetadata;
}

const { title, pubDate, excerpt, banner } = Astro.props;

const ogImage = await getImage({ src: banner, width: 1200, format: 'jpeg' });

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: '2-digit',
  year: 'numeric',
});
---

<BaseLayout
  title={`${title} - Yusra Imran`}
  description={excerpt}
  image={ogImage.src}
  type="article"
  publishedTime={pubDate}
>
  <article class="about active" data-page="blog">
    <header>
      <time
        datetime={pubDate.toISOString()}
        class="block text-light-gray-70 text-[length:var(--fs-6)] font-light mt-[30px] mb-[15px]"
      >
        {formattedDate}
      </time>
      <h1 class="h1 article-title mb-[30px]">{title}</h1>
    </header>

    <section class="about-text text-light-gray font-light leading-[1.6] md:mb-[40px]">
      <figure class="mb-[30px] rounded-[16px] overflow-hidden">
        <Image src={banner} alt={title} class="w-full" />
      </figure>

      <p class="text-left text-lg md:text-2xl font-light mb-[30px] border-l-4 pl-4">
        {excerpt}
      </p>

      <div class="prose">
        <slot />
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .prose h2 {
    color: var(--color-white-2);
    font-size: var(--fs-2);
    font-weight: var(--fw-500);
    margin-top: 30px;
    margin-bottom: 15px;
  }
  .prose h3 {
    color: var(--color-white-2);
    font-size: var(--fs-3);
    font-weight: var(--fw-500);
    margin-top: 25px;
    margin-bottom: 12px;
  }
  .prose p {
    margin-bottom: 15px;
  }
  .prose ul {
    margin-bottom: 15px;
    padding-left: 20px;
    list-style: disc;
  }
  .prose ol {
    margin-bottom: 15px;
    padding-left: 20px;
    list-style: decimal;
  }
  .prose li {
    margin-bottom: 8px;
  }
  .prose img {
    border-radius: 12px;
    margin: 20px 0;
    width: 100%;
  }
  .prose a {
    color: var(--color-orange-yellow-crayola);
    text-decoration: underline;
  }
  .prose blockquote {
    border-left: 3px solid var(--color-orange-yellow-crayola);
    padding-left: 15px;
    margin: 20px 0;
    font-style: italic;
  }
  .prose code {
    background: var(--color-onyx);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.9em;
  }
  .prose pre {
    background: var(--color-eerie-black-1);
    padding: 15px;
    border-radius: 12px;
    overflow-x: auto;
    margin: 20px 0;
  }
  .prose pre code {
    background: none;
    padding: 0;
  }
</style>