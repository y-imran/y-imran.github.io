---
import { Font } from 'astro:assets';
import '@src/styles/main.css';
import Sidebar from '@components/Sidebar.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/ui/Footer.astro';
import SEO from '@components/head/SEO.astro';
import type { BreadcrumbItem } from '@components/head/SEO.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    author?: string;
    section?: string;
    tags?: string[];
  };
  canonical?: string;
  breadcrumbs?: BreadcrumbItem[];
  noindex?: boolean;
}

const {
  title = 'Home - Yusra Imran',
  description,
  image,
  type = 'website',
  article,
  canonical,
  breadcrumbs,
  noindex,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      article={article}
      canonical={canonical}
      breadcrumbs={breadcrumbs}
      noindex={noindex}
    />

    <Font cssVariable="--font-poppins" preload />

    <script
      type="module"
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script
      nomodule
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
  </head>
  <body>
    <main
      class="mt-[15px] mx-3 mb-[75px] min-w-[259px]
             md:mt-[60px] md:mb-[100px]
             xl:mb-[60px]
             2xl:max-w-[1200px] 2xl:mx-auto 2xl:flex 2xl:justify-center 2xl:items-stretch 2xl:gap-[25px]"
    >
      <Sidebar />
      <div
        class="xl:relative xl:w-max xl:m-auto
               2xl:min-w-[75%] 2xl:w-[75%] 2xl:m-0"
      >
        <Navbar />
        <slot />
        <Footer />
      </div>
    </main>
  </body>
</html>