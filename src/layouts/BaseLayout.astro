---
import { Font } from 'astro:assets';
import '@src/styles/main.css';
import Sidebar from '@components/ui/common/Sidebar.astro';
import Navbar from '@components/ui/common/Navbar.astro';
import Footer from '@components/ui/common/Footer.astro';
import SEO from '@components/ui/common/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title = 'Home - Yusra Imran',
  description = 'Personal website of Yusra Imran, a medical laboratory technologist turned data analyst in Karachi, Pakistan. Tableau dashboards, data projects, and blog posts.',
  image,
  type = 'website',
  publishedTime,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#181819" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
    />

    <!-- Poppins font (optimized by Astro) -->
    <Font cssVariable="--font-poppins" preload />

    <!-- Ionicons -->
    <script
      type="module"
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script
      nomodule
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
  </head>
  <body>
    <main
      class="mt-[15px] mx-3 mb-[80px] min-w-[259px]
             md:mt-[60px] md:mb-[85px]
             xl:mb-[60px]
             2xl:max-w-[1200px] 2xl:mx-auto 2xl:flex 2xl:justify-center 2xl:items-stretch 2xl:gap-[25px]"
    >
      <Sidebar />
      <div
        class="xl:relative xl:w-max xl:m-auto
               2xl:min-w-[75%] 2xl:w-[75%] 2xl:m-0"
      >
        <Navbar />
        <slot />
        <Footer />
      </div>
    </main>
  </body>
</html>