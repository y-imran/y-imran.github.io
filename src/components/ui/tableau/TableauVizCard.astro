---
import type { TableauVisualization } from '@data/tableau-visualizations.ts';

interface Props {
  date: string;
  visualizations: TableauVisualization[];
}

const { date, visualizations } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(`${date}T00:00:00`));

const thumbnailViz = visualizations.find((viz) => viz.thumbnail);
---

<div class="tv-card">
  <div class="tv-card-thumb">
    {
      thumbnailViz && thumbnailViz.thumbnail ? (
        <img
          src={thumbnailViz.thumbnail.src}
          alt={thumbnailViz.title}
          loading="lazy"
          class="tv-card-img"
          width="320"
        />
      ) : (
        <div class="tv-card-placeholder" aria-hidden="true">
          <ion-icon name="bar-chart-outline"></ion-icon>
        </div>
      )
    }
  </div>

  <div class="tv-card-body">
    <time class="tv-card-date">{formattedDate}</time>

    <ul class="tv-card-list">
      {
        visualizations.map((viz) => (
          <li class="tv-card-item">
            <div class="tv-card-title-row">
              <span class="tv-card-title">{viz.title}</span>
              {viz.isVotd && (
                <span class="tv-card-votd" aria-label="Viz of the Day">
                  <ion-icon name="star"></ion-icon>
                  VOTD
                </span>
              )}
            </div>
            <a
              href={viz.tableauUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="tv-card-link"
            >
              View on Tableau Public
              <ion-icon name="open-outline" aria-hidden="true" class="tv-card-link-icon"></ion-icon>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .tv-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tv-card-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-onyx);
    border: 1px solid var(--color-jet);
  }

  .tv-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tv-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-light-gray-70);
    font-size: 30px;
  }

  .tv-card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tv-card-date {
    color: var(--color-light-gray-70);
    font-size: var(--fs-7);
    font-weight: var(--fw-500);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tv-card-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tv-card-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-jet);
  }

  .tv-card-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .tv-card-title-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tv-card-title {
    color: var(--color-white-2);
    font-size: var(--fs-6);
    font-weight: var(--fw-500);
    line-height: 1.4;
  }

  .tv-card-votd {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--color-orange-yellow-crayola) 18%, transparent);
    color: var(--color-orange-yellow-crayola);
    font-size: var(--fs-8);
    font-weight: var(--fw-600);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 2px 7px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-orange-yellow-crayola) 45%, transparent);
  }

  .tv-card-votd ion-icon {
    font-size: 11px;
  }

  .tv-card-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--color-orange-yellow-crayola);
    font-size: var(--fs-7);
    font-weight: var(--fw-500);
    text-decoration: none;
    width: max-content;
    transition: opacity var(--transition-1);
  }

  .tv-card-link:hover,
  .tv-card-link:focus-visible {
    opacity: 0.8;
  }

  .tv-card-link-icon {
    font-size: 14px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>