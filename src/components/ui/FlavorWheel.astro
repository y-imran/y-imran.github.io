---
---

<div class="wheel-block">
  <div id="flavor-wheel" class="wheel-canvas" role="img" aria-label="Interactive Coffee Taster's Flavor Wheel standing in for the zero in 404">
    <div class="wheel-skeleton" aria-hidden="true"></div>
  </div>
</div>

<style>
  .wheel-block {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .wheel-canvas {
    position: relative;
    width: min(88vw, 560px, 56vh);
    aspect-ratio: 1 / 1;
  }

  .wheel-skeleton {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 15deg,
      hsl(350 60% 45% / 0.35),
      hsl(25 85% 50% / 0.35),
      hsl(80 55% 45% / 0.35),
      hsl(160 45% 40% / 0.35),
      hsl(195 40% 55% / 0.35),
      hsl(35 35% 35% / 0.35),
      hsl(300 40% 40% / 0.35),
      hsl(20 45% 40% / 0.35),
      hsl(350 60% 45% / 0.35)
    );
    -webkit-mask: radial-gradient(farthest-side, transparent 25.5%, #000 26% 99%, transparent 100%);
    mask: radial-gradient(farthest-side, transparent 25.5%, #000 26% 99%, transparent 100%);
    animation: wheel-pulse 1.8s ease-in-out infinite;
    transition: opacity 0.45s ease;
  }

  .wheel-skeleton.gone {
    opacity: 0;
    animation: none;
  }

  @keyframes wheel-pulse {
    50% {
      opacity: 0.45;
      filter: saturate(1.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wheel-skeleton {
      animation: none;
    }
  }

  @media (min-width: 1024px) {
    .wheel-canvas {
      width: min(52vw, 620px, 54vh);
    }
  }
</style>

<style is:global>
  #flavor-wheel svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    pointer-events: none;
  }

  #flavor-wheel svg path,
  #flavor-wheel svg circle {
    pointer-events: auto;
  }
</style>

<script>
  import * as d3 from 'd3';
  import type { BaseType, Transition } from 'd3';
  import { flavorWheel } from '@data/flavor-wheel';
  import type { FlavorNode } from '@data/flavor-wheel';

  const container = document.getElementById('flavor-wheel');

  if (container && !container.dataset.mounted) {
    container.dataset.mounted = 'true';

    interface Slice {
      x0: number;
      x1: number;
      y0: number;
      y1: number;
    }
    type RNode = d3.HierarchyRectangularNode<FlavorNode> & {
      current: Slice;
      target?: Slice;
      dropped?: boolean;
    };

    const width = 600;
    const radius = width / 2;
    const hole = 78;

    const root = d3
      .hierarchy<FlavorNode>(flavorWheel)
      .sum((d) => (d.children ? 0 : 1)) as unknown as RNode;
    const maxY = root.height + 1;
    d3.partition<FlavorNode>().size([2 * Math.PI, maxY])(root);

    root.each((d) => {
      if (!d.children && d.depth > 0) d.y1 = maxY;
    });

    const yR = (y: number) =>
      y <= 0 ? 0 : hole + (Math.min(y, maxY) - 1) * ((radius - hole) / (maxY - 1));

    const fillOf = (d: RNode) => d.data.color ?? d.parent?.data?.color ?? '#888';
    const textFill = (hex: string) =>
      (d3.hsl(hex).l ?? 0.5) > 0.62 ? '#21252b' : '#f8f9fa';

    const baseFont = (d: RNode) => (d.depth === 1 ? 16 : d.depth === 2 ? 11.5 : 10);
    const avail = (s: Slice) => Math.abs(yR(s.y1) - yR(s.y0)) * 0.8;

    const arcVisible = (d: Slice) =>
      d.y1 <= maxY + 1 && d.y0 >= 0 && d.x1 - d.x0 > 1e-3 && yR(d.y1) > yR(d.y0);

    const labelVisible = (d: RNode, s: Slice) =>
      arcVisible(s) && (s.y1 - s.y0) * (s.x1 - s.x0) > 0.02 && !d.dropped;

    const labelTransform = (s: Slice) => {
      const x = (((s.x0 + s.x1) / 2) * 180) / Math.PI;
      const y = (yR(s.y0) + yR(s.y1)) / 2;
      return `rotate(${x - 90}) translate(${y},0) rotate(${x < 180 ? 0 : 180})`;
    };

    root.each((d) => {
      const n = d as RNode;
      n.current = { x0: n.x0, x1: n.x0, y0: n.y0, y1: n.y1 };
      n.target = { x0: n.x0, x1: n.x1, y0: n.y0, y1: n.y1 };
    });

    const svg = d3
      .select(container)
      .append('svg')
      .attr('viewBox', [0, 0, width, width])
      .attr('font-family', 'var(--font-poppins), ui-sans-serif, system-ui, sans-serif');

    const g = svg.append('g').attr('transform', `translate(${width / 2},${width / 2})`);

    const arc = d3
      .arc<RNode>()
      .startAngle((d) => d.current.x0)
      .endAngle((d) => d.current.x1)
      .padAngle((d) => Math.min((d.current.x1 - d.current.x0) / 2, 0.0018))
      .padRadius(radius)
      .innerRadius((d) => yR(d.current.y0))
      .outerRadius((d) => Math.max(yR(d.current.y1) - 1.5, yR(d.current.y0)));

    const nodes = root.descendants().slice(1) as RNode[];

    const path = g
      .append('g')
      .selectAll('path')
      .data(nodes)
      .join('path')
      .attr('fill', fillOf)
      .attr('fill-opacity', 0.9)
      .attr('d', (d) => arc(d) ?? '')
      .style('cursor', 'pointer');

    const label = g
      .append('g')
      .attr('pointer-events', 'none')
      .attr('text-anchor', 'middle')
      .selectAll('text')
      .data(nodes)
      .join('text')
      .attr('dy', '0.35em')
      .attr('font-size', (d) => baseFont(d))
      .attr('font-weight', (d) => (d.depth === 1 ? 700 : d.depth === 2 ? 600 : 500))
      .attr('letter-spacing', '0.01em')
      .attr('fill', (d) => textFill(fillOf(d)))
      .attr('fill-opacity', (d) => +labelVisible(d, d.current))
      .attr('transform', (d) => labelTransform(d.current))
      .text((d) => d.data.name);

    const measureLabels = () => {
      label.each(function (d) {
        const el = this as SVGTextElement;
        el.setAttribute('font-size', String(baseFont(d)));
        const len = el.getComputedTextLength();
        const a = avail(d.target ?? d.current);
        if (len <= a) {
          d.dropped = false;
        } else if (len <= a / 0.55) {
          d.dropped = false;
          el.setAttribute('font-size', (baseFont(d) * (a / len)).toFixed(2));
        } else {
          d.dropped = true;
        }
      });
      label.attr('fill-opacity', (d) => +labelVisible(d, d.current));
    };
    measureLabels();
    document.fonts?.ready?.then(measureLabels);

    const centerText = g
      .append('text')
      .attr('text-anchor', 'middle')
      .attr('pointer-events', 'none')
      .attr('dy', '0.35em')
      .attr('fill', 'hsl(0 0% 92%)')
      .attr('opacity', 0);

    const center = g
      .append('circle')
      .attr('r', hole - 2)
      .attr('fill', 'transparent')
      .style('cursor', 'pointer')
      .datum(root);

    const setCenter = (name: string, big: boolean) =>
      centerText
        .text(name)
        .attr('font-size', big ? 30 : name.length > 13 ? 13 : name.length > 8 ? 17 : 22)
        .attr('font-weight', big ? 900 : 600)
        .attr('opacity', name ? 1 : 0);

    let currentFocus = root;

    function runZoom(
      dur: number,
      delayFn: (d: RNode) => number,
      ease: (t: number) => number,
    ) {
      const t = g.transition().duration(dur).ease(ease);

      path
        .transition(t as unknown as Transition<BaseType, any, any, any>)
        .delay(delayFn)
        .tween('data', (d) => {
          const i = d3.interpolate(d.current, d.target!);
          d.current = i(0) as Slice;
          return (tt: number) => {
            d.current = i(tt) as Slice;
          };
        })
        .filter(function (d) {
          return (
            +(this as SVGPathElement).getAttribute('fill-opacity')! > 0 ||
            arcVisible(d.target!)
          );
        })
        .attr('fill-opacity', (d) => (arcVisible(d.target!) ? 0.9 : 0))
        .attrTween('d', (d) => () => arc(d) ?? '');

      label
        .filter(function (d) {
          return (
            +(this as SVGTextElement).getAttribute('fill-opacity')! > 0 ||
            labelVisible(d, d.target!)
          );
        })
        .transition(t as unknown as Transition<BaseType, any, any, any>)
        .delay(delayFn)
        .attrTween('transform', (d) => () => labelTransform(d.current))
        .attrTween('fill-opacity', (d) => () => String(+labelVisible(d, d.current)));
    }

    function zoomTo(p: RNode) {
      currentFocus = p;
      center.datum(p.parent ?? root);
      setCenter(p === root ? '' : p.data.name, true);

      root.each((d) => {
        const n = d as RNode;
        n.target = {
          x0: Math.max(0, Math.min(1, (n.x0 - p.x0) / (p.x1 - p.x0))) * 2 * Math.PI,
          x1: Math.max(0, Math.min(1, (n.x1 - p.x0) / (p.x1 - p.x0))) * 2 * Math.PI,
          y0: Math.max(0, n.y0 - p.y0),
          y1: Math.max(0, n.y1 - p.y0),
        };
      });

      runZoom(750, () => 0, d3.easeCubicOut);
    }

    path.on('click', (_event, d) => zoomTo(d));
    center.on('click', (event) =>
      zoomTo(d3.select(event.currentTarget as SVGCircleElement).datum() as RNode),
    );

    path.on('pointerenter', (_event, d) => {
      const seq = d.ancestors().reverse().slice(1);
      path.attr('fill-opacity', (n) =>
        !arcVisible((n as RNode).current) ? 0 : seq.includes(n) ? 0.95 : 0.25,
      );
      setCenter(d.data.name, false);
    });

    g.on('pointerleave', () => {
      path.attr('fill-opacity', (n) => (arcVisible((n as RNode).current) ? 0.9 : 0));
      setCenter(currentFocus === root ? '' : currentFocus.data.name, true);
    });

    runZoom(1100, (d) => 150 + (d.x0 / (2 * Math.PI)) * 500, d3.easeCubicInOut);

    const skeleton = container.querySelector('.wheel-skeleton');
    if (skeleton) {
      skeleton.classList.add('gone');
      setTimeout(() => skeleton.remove(), 500);
    }
  }
</script>
