---
interface Stage {
  icon: string;
  label: string;
}

interface Lane {
  label: string;
  stages: Stage[];
  destination: string;
  nested?: Stage;
  nestedNote?: string;
}

interface Props {
  title?: string;
  lanes: Lane[];
  caption?: string;
}

const { title, lanes, caption } = Astro.props;
---

<figure class="my-5">
  <div class="w-full rounded-[10px] border border-jet bg-eerie-black-1 p-4 md:p-6">

    {title && (
      <p class="text-center text-light-gray text-sm md:text-base font-medium leading-[1.4] mb-4">
        {title}
      </p>
    )}

    <div class="space-y-3">
      {lanes.map((lane) => (
        <div class="rounded-[8px] border border-jet bg-onyx p-3">
          <p class="text-[11px] uppercase tracking-[0.18em] text-light-gray-70">
            {lane.label}
          </p>

          <div class="mt-3 flex flex-col lg:flex-row lg:items-center gap-1.5 lg:gap-1">
            {lane.stages.map((stage) => (
              <Fragment>
                <div class="flex w-full items-center justify-center gap-2 rounded-[6px] border border-jet bg-eerie-black-1 px-3 py-2 text-xs text-light-gray lg:w-auto lg:justify-start">
                  <ion-icon name={stage.icon} aria-hidden="true" class="text-vegas-gold text-[14px]"></ion-icon>
                  <span>{stage.label}</span>
                </div>

                <div class="flex justify-center text-orange-yellow-crayola">
                  <ion-icon name="arrow-down-outline" aria-hidden="true" class="text-[16px] lg:hidden"></ion-icon>
                  <ion-icon name="arrow-forward-outline" aria-hidden="true" class="text-[18px] hidden lg:block"></ion-icon>
                </div>
              </Fragment>
            ))}

            <div class="w-full rounded-[6px] border border-vegas-gold/40 bg-vegas-gold/5 px-3 py-2 lg:w-auto">
              <div class="flex items-center justify-center gap-2 lg:justify-start">
                <ion-icon name="layers-outline" aria-hidden="true" class="text-vegas-gold text-[14px]"></ion-icon>
                <span class="text-xs uppercase tracking-[0.08em] text-vegas-gold">{lane.destination}</span>
              </div>

              {lane.nested && (
                <div class="mt-2 rounded-[5px] border border-vegas-gold/30 bg-vegas-gold/10 px-2 py-1.5">
                  <div class="flex items-center justify-center gap-1.5 lg:justify-start">
                    <ion-icon name={lane.nested.icon} aria-hidden="true" class="text-vegas-gold text-[13px]"></ion-icon>
                    <span class="text-[11px] text-vegas-gold">{lane.nested.label}</span>
                  </div>
                  {lane.nestedNote && (
                    <p class="mt-1 text-center text-[10px] italic text-light-gray-70 lg:text-left">
                      {lane.nestedNote}
                    </p>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>

  {caption && (
    <figcaption class="text-light-gray-70 text-xs md:text-sm font-[var(--fw-300)] text-center font-sans italic mt-3">
      {caption}
    </figcaption>
  )}
</figure>
