---
import PdfDownloadButton from '@components/ui/blog/PdfDownloadButton.astro';

export interface PdfDownloadItem {
  url: string;
  name: string;
  size: number;
  fileName?: string;
}

interface Props {
  items: PdfDownloadItem[];
  heading?: string;
}

const { items, heading } = Astro.props;
---

<fieldset class="mt-6 mb-[20px] min-w-0 rounded-2xl border border-light-gray/40 px-2 pb-3 pt-1 md:px-3 md:pb-4">
  {heading && (
    <legend class="px-2 text-white-2 text-lg md:text-xl font-bold leading-[1.3]">{heading}</legend>
  )}

  <div class="grid grid-cols-3 lg:grid-cols-5 gap-2 md:gap-3 pt-2">
    {items.map((item) => <PdfDownloadButton {...item} />)}
  </div>
</fieldset>
