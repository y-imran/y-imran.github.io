---

interface Props {
  headers?: string[];
  rows?: string[][];
}

const { headers = [], rows = [] } = Astro.props;
---

<div class="w-full my-[20px]">
  {/* Mobile: one card per row, so nothing is cut off or needs scrolling */}
  <div class="sm:hidden flex flex-col gap-2">
    {rows.map((row) => (
      <div class="rounded-[10px] border border-jet bg-onyx px-3 py-2">
        {row.map((cell, cellIndex) => (
          <div class="flex items-start justify-between gap-3 py-1.5 border-b border-jet/50 last:border-0">
            {headers[cellIndex] && (
              <span class="shrink-0 text-[10px] uppercase tracking-[0.08em] text-light-gray-70 pt-0.5">
                {headers[cellIndex]}
              </span>
            )}
            <span class="min-w-0 text-right text-light-gray text-sm break-words">{cell}</span>
          </div>
        ))}
      </div>
    ))}
  </div>

  {/* Tablet / desktop: regular table */}
  <div class="hidden sm:block">
    <table
      class="w-full border-collapse text-light-gray text-xs sm:text-sm lg:text-base font-light leading-[1.6] rounded-[12px] overflow-hidden border border-jet"
    >
      {headers.length > 0 && (
        <thead>
          <tr class="bg-eerie-black-1">
            {headers.map((header) => (
              <th
                class="text-left font-semibold text-vegas-gold px-2 md:px-4 py-2.5 md:py-3 border-b border-jet align-bottom [overflow-wrap:anywhere]"
              >
                {header}
              </th>
            ))}
          </tr>
        </thead>
      )}
      <tbody>
        {rows.map((row, rowIndex) => (
          <tr class={rowIndex % 2 === 1 ? 'bg-eerie-black-1/50' : undefined}>
            {row.map((cell, cellIndex) => (
              <td
                class={`px-2 md:px-4 py-2.5 md:py-3 align-top border-b border-jet [overflow-wrap:anywhere] ${cellIndex === 0 ? 'text-white-2 font-normal' : ''}`}
              >
                {cell}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
