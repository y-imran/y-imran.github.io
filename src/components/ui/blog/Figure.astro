---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
const altText = alt ?? caption ?? '';
---

<figure class="my-5">
  <div class="w-full rounded-[10px] overflow-hidden bg-onyx border border-jet">
    <Image src={src} alt={altText} loading="lazy" class="w-full h-auto block" />
  </div>
  {caption && (
    <figcaption class="text-light-gray-70 text-xs md:text-sm font-[var(--fw-300)] text-center font-sans italic mt-3">{caption}</figcaption>
  )}
</figure>