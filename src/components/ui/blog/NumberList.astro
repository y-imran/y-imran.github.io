---
import Link from './Link.astro';

type Token =
  | { type: 'text'; value: string }
  | { type: 'bold'; value: string }
  | { type: 'link'; value: string; url: string };

interface Props {
  items?: string[];
  indent?: number;
}

// Splits an item string into text / **bold** / [linkText](url) tokens.
// Keep in sync with BulletList.astro (same logic).
function tokenize(item: string): Token[] {
  const tokens: Token[] = [];
  const re = /\*\*(.+?)\*\*|\[(.+?)\]\((.+?)\)/g;
  let last = 0;
  let match: RegExpExecArray | null;
  while ((match = re.exec(item)) !== null) {
    if (match.index > last) {
      tokens.push({ type: 'text', value: item.slice(last, match.index) });
    }
    if (match[1] !== undefined) {
      tokens.push({ type: 'bold', value: match[1] });
    } else if (match[2] !== undefined && match[3] !== undefined) {
      tokens.push({
        type: 'link',
        value: match[2],
        // tolerate surrounding quotes: [text]('url') → url
        url: match[3].replace(/^['"]|['"]$/g, ''),
      });
    }
    last = re.lastIndex;
  }
  if (last < item.length) {
    tokens.push({ type: 'text', value: item.slice(last) });
  }
  return tokens;
}

const { items, indent } = Astro.props;
---

<ol
  class="text-light-gray text-base md:text-xl font-light leading-[1.6] mb-[15px] list-decimal list-inside pl-3 md:pl-6"
  style={indent ? `margin-left: ${indent}rem` : undefined}
>
  {items ? (
    items.map((item) => (
      <li class="list-decimal list-inside">
      {tokenize(item).map((token) =>
        token.type === 'bold' ? (
          <strong class="font-semibold">{token.value}</strong>
        ) : token.type === 'link' ? (
          <Link url={token.url} linkText={token.value} />
        ) : (
          token.value
        )
      )}
      </li>
    ))
  ) : (
    // children mode: direct <li> elements from MDX, e.g. for images in items
    <slot />
  )}
</ol>

<style>
  /* Markers for <li> children rendered from MDX (they don't get the utility classes) */
  ol > :global(li) {
    list-style-type: decimal;
    list-style-position: inside;
  }

  /* Small vertical gap between numbered items (items-mode and children-mode) */
  ol > :global(li + li) {
    margin-top: 8px;
  }
</style>