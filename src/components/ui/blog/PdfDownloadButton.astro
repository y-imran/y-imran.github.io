---
interface Props {
  url: string;
  name: string;
  size: number;
  fileName?: string;
}

const { url, name, size, fileName } = Astro.props;

const formatSize = (bytes: number) =>
  bytes >= 1024 * 1024
    ? `${(bytes / (1024 * 1024)).toFixed(1)} MB`
    : `${Math.max(1, Math.round(bytes / 1024))} KB`;
---

<a
  href={url}
  download={fileName}
  class="group flex items-center gap-2 md:gap-3 rounded-[10px] border border-jet bg-eerie-black-1 px-2 py-2.5 md:px-3 md:py-3 transition-colors duration-200 hover:border-orange-yellow-crayola hover:bg-onyx"
>
  <ion-icon
    name="document-text-outline"
    aria-hidden="true"
    class="shrink-0 text-[20px] md:text-[26px] text-orange-yellow-crayola"
  ></ion-icon>

  <span class="min-w-0">
    <span class="block text-[11px] md:text-sm font-semibold leading-[1.3] text-white-2 line-clamp-2">
      {name}
    </span>
    <span class="block text-[10px] md:text-xs font-light text-light-gray-70">
      {formatSize(size)}
    </span>
  </span>
</a>
