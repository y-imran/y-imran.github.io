---
import { tableSchemas, type SchemaColumn, type TableName } from '@data/data-tables';

interface Props {
  /** Which data table to render (defaults to the main VOTD table). */
  table?: TableName;
  /** Render an ad-hoc list instead of a preset table. */
  columns?: SchemaColumn[];
  /** Table name shown in the header chip (defaults to `table`). */
  name?: string;
  /** Small label above the table name. */
  label?: string;
  /**
   * How many side-by-side groups the fields are split into.
   * Defaults to `1` (one row per field); pass 2–4 to fan them out.
   */
  groups?: 1 | 2 | 3 | 4;
  /** Drop the outer vertical margin (useful inside a grid). */
  flush?: boolean;
  /** Optional footnote under the table. */
  note?: string;
}

const {
  table = 'viz_of_the_day',
  columns,
  name,
  label = 'Data table',
  groups,
  flush = false,
  note,
} = Astro.props;

const rows: SchemaColumn[] = columns ?? tableSchemas[table];
const tableName = name ?? table;
const groupCount = groups ?? 1;

const perGroup = Math.ceil(rows.length / groupCount);
const groupsOfRows = Array.from({ length: groupCount }, (_, i) =>
  rows.slice(i * perGroup, (i + 1) * perGroup),
).filter((group) => group.length > 0);

// Groups sit side by side from `sm` up; on phones everything stacks in one
// column so the fields stay readable without sideways scrolling.
const gridClass = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 xl:grid-cols-3',
  4: 'sm:grid-cols-2 xl:grid-cols-4',
}[groupsOfRows.length] ?? '';

// theme accents (mirrors --color-vegas-gold / --color-orange-yellow-crayola)
const ACCENT = 'hsl(192, 85%, 57%)';
const ACCENT_BG = 'hsla(192, 85%, 47%, 0.12)';
const ACCENT_LINE = 'hsla(192, 85%, 47%, 0.35)';
---

<div
  class:list={[
    'schema-table overflow-hidden rounded-[12px] border border-jet bg-eerie-black-1',
    flush ? '' : 'my-[20px]',
  ]}
>
  <!-- header -->
  <div
    class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-jet px-3 py-1.5 md:px-3.5"
  >
    <div class="flex items-center gap-2">
      <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-light-gray-70">{label}</span>
      <span
        class="rounded-[5px] border px-1.5 py-0.5 font-mono text-[11px] leading-none text-white-2"
        style={`border-color:${ACCENT_LINE}; background:${ACCENT_BG};`}>{tableName}</span>
    </div>
  </div>

  <!-- groups of name + type pairs -->
  <div class="overflow-x-auto">
    <div class:list={['grid gap-x-4', gridClass]}>
      {groupsOfRows.map((group) => (
        <table class="w-full border-collapse text-left">
          <tbody>
            {group.map((col, index) =>
              col.ellipsis ? (
                <tr
                  class:list={[
                    'transition-colors last:border-b-0',
                    group[index + 1]?.ellipsis ? '' : 'border-b border-jet/40',
                  ]}
                >
                  <td class="w-[1%] whitespace-nowrap py-[3px] pl-3 pr-2.5 align-middle md:pl-3.5">
                    <span class="font-mono text-[11px] tracking-[0.3em] text-light-gray-70/55">...</span>
                  </td>
                  <td class="whitespace-nowrap py-[3px] pr-3 align-middle md:pr-3.5" />
                </tr>
              ) : (
                <>
                  <tr
                    class:list={[
                      'transition-colors hover:bg-jet/25',
                      col.comment ? '' : 'border-b border-jet/40',
                      'last:border-b-0',
                    ]}
                  >
                    <td class="w-[1%] whitespace-nowrap py-[6px] pl-3 pr-2.5 align-middle md:pl-3.5">
                      <span class="font-mono text-[11.5px] font-medium text-white-2">{col.name}</span>
                    </td>
                    <td class="whitespace-nowrap py-[6px] pr-3 align-middle md:pr-3.5">
                      <span
                        class="inline-block rounded-full px-2 py-[2px] text-[9px] font-semibold uppercase tracking-[0.03em]"
                        style={`color:${ACCENT}; background:${ACCENT_BG};`}
                      >
                        {col.type}
                      </span>
                    </td>
                  </tr>
                  {col.comment && (
                    <tr class="border-b border-jet/40 last:border-b-0">
                      <td
                        colspan="2"
                        class="py-[2px] pb-[8px] pl-3 pr-3 align-top text-[10px] font-light leading-[1.45] text-light-gray-70/70 md:pl-3.5 md:pr-3.5"
                      >
                        {col.comment}
                      </td>
                    </tr>
                  )}
                </>
              )
            )}
          </tbody>
        </table>
      ))}
    </div>
  </div>

  {note && (
    <div
      class="border-t border-jet px-3 py-1.5 text-[11px] font-light leading-[1.5] text-light-gray-70 md:px-3.5"
    >
      {note}
    </div>
  )}
</div>
