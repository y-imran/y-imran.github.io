---
interface Props {
  sources: string[];
  stages: string[];
  destinations: string[];
  sourceLabel?: string;
  pipelineLabel?: string;
  destinationLabel?: string;
  sourceNote?: string;
  pipelineNote?: string;
  destinationNote?: string;
  caption?: string;
}

const {
  sources,
  stages,
  destinations,
  sourceLabel = 'Sources',
  pipelineLabel = 'The pipeline',
  destinationLabel = 'Destination',
  sourceNote,
  pipelineNote,
  destinationNote,
  caption,
} = Astro.props;
---

<figure class="my-5">
  <div class="w-full rounded-[10px] border border-jet bg-eerie-black-1 p-4 md:p-6">
    <div class="flex flex-col md:flex-row md:items-center gap-3 md:gap-2">

      {/* Sources */}
      <div class="flex-1 min-w-0">
        <p class="text-center text-[11px] uppercase tracking-[0.18em] text-light-gray-70 mb-2">
          {sourceLabel}
        </p>
        <div class="rounded-[8px] border border-jet bg-onyx px-3 py-2.5">
          <ul class="text-light-gray text-sm md:text-base leading-[1.7]">
            {sources.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        {sourceNote && (
          <p class="mt-2 text-center text-[11px] italic text-light-gray-70">{sourceNote}</p>
        )}
      </div>

      {/* Arrow: down on small screens, right on larger ones */}
      <div class="flex justify-center text-orange-yellow-crayola md:px-1 shrink-0">
        <ion-icon name="arrow-down-outline" aria-hidden="true" class="text-[22px] md:hidden"></ion-icon>
        <ion-icon name="arrow-forward-outline" aria-hidden="true" class="text-[22px] hidden md:block"></ion-icon>
      </div>

      {/* Pipeline stages */}
      <div class="flex-1 min-w-0">
        <p class="text-center text-[11px] uppercase tracking-[0.18em] text-light-gray-70 mb-2">
          {pipelineLabel}
        </p>
        <div class="rounded-[8px] border border-jet bg-onyx p-3">
          {stages.map((stage, index) => (
            <Fragment>
              <div class="rounded-[6px] border border-vegas-gold/40 bg-vegas-gold/10 px-3 py-2 text-center text-xs md:text-sm uppercase tracking-[0.12em] font-medium text-vegas-gold">
                {stage}
              </div>
              {index < stages.length - 1 && (
                <div class="flex justify-center py-1 text-light-gray-70">
                  <ion-icon name="arrow-down-outline" aria-hidden="true" class="text-[14px]"></ion-icon>
                </div>
              )}
            </Fragment>
          ))}
        </div>
        {pipelineNote && (
          <p class="mt-2 text-center text-[11px] italic text-light-gray-70">{pipelineNote}</p>
        )}
      </div>

      {/* Arrow: down on small screens, right on larger ones */}
      <div class="flex justify-center text-orange-yellow-crayola md:px-1 shrink-0">
        <ion-icon name="arrow-down-outline" aria-hidden="true" class="text-[22px] md:hidden"></ion-icon>
        <ion-icon name="arrow-forward-outline" aria-hidden="true" class="text-[22px] hidden md:block"></ion-icon>
      </div>

      {/* Destinations */}
      <div class="flex-1 min-w-0">
        <p class="text-center text-[11px] uppercase tracking-[0.18em] text-light-gray-70 mb-2">
          {destinationLabel}
        </p>
        <div class="rounded-[8px] border border-jet bg-onyx px-3 py-2.5">
          <ul class="text-light-gray text-sm md:text-base leading-[1.7]">
            {destinations.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        {destinationNote && (
          <p class="mt-2 text-center text-[11px] italic text-light-gray-70">{destinationNote}</p>
        )}
      </div>

    </div>
  </div>

  {caption && (
    <figcaption class="text-light-gray-70 text-xs md:text-sm font-[var(--fw-300)] text-center font-sans italic mt-3">
      {caption}
    </figcaption>
  )}
</figure>
