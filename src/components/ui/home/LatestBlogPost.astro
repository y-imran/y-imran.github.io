---
import { getCollection } from 'astro:content';

const [latestPost] = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

{
  latestPost && (
    <section class="mt-[40px]">
      <p class="eyebrow eyebrow-underline">Latest Blog Post</p>

      <a
        href={`/blog/${latestPost.data.slug}/`}
        class="lp-card group relative mt-[24px] flex flex-col lg:flex-row bg-[image:var(--border-gradient-onyx)] rounded-[16px] shadow-[var(--shadow-4)] z-[1]"
      >
        <figure class="w-full lg:w-[40%] aspect-video lg:aspect-auto rounded-[12px] md:rounded-[16px] lg:rounded-r-none overflow-hidden">
          <img
            src={latestPost.data.banner.src}
            alt={latestPost.data.title}
            loading="lazy"
            class="w-full h-full object-cover transition-all duration-[250ms] ease group-hover:scale-110"
          />
        </figure>

        <div class="lg:w-[60%] flex flex-col justify-center p-[15px] md:p-[25px] lg:p-[30px]">
          <div class="text-xs md:text-sm flex justify-start items-center gap-[7px] mb-[10px] uppercase font-light tracking-wide text-light-gray-70">
            <span>{latestPost.data.category}</span>
            <span class="bg-light-gray-70 w-1 h-1 rounded-[4px]"></span>
            <time datetime={latestPost.data.pubDate.toISOString()}>
              {latestPost.data.pubDate.toLocaleDateString('en-US', {
                month: 'short',
                day: '2-digit',
                year: 'numeric',
              })}
            </time>
            <span class="bg-light-gray-70 w-1 h-1 rounded-[4px]"></span>
            <span>{latestPost.data.readTimeMins} mins</span>
          </div>

          <h3 class="h3 mb-[10px] leading-[1.3] transition-colors duration-[250ms] ease group-hover:text-orange-yellow-crayola">
            {latestPost.data.title}
          </h3>
          <p class="text-light-gray text-[length:var(--fs-6)] font-light leading-[1.6]">
            {latestPost.data.excerpt}
          </p>
        </div>
      </a>
    </section>
  )
}

<style>
  .lp-card::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background: var(--color-eerie-black-1);
    z-index: -1;
  }
</style>
