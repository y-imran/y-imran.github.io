---
import projects, { ProjectCategory } from '@src/data/projects.ts';

const filterCategories = ['All', ...Object.values(ProjectCategory)];
---

<article class="portfolio active" data-page="portfolio">
  <header>
    <h2 class="h2 article-title mb-[30px]">Portfolio</h2>
  </header>

  <section class="projects">
    <!-- Desktop filter -->
    <ul
      class="filter-list hidden lg:flex lg:justify-start lg:items-center lg:gap-[25px] lg:pl-[5px] lg:mb-[30px]"
    >
      {filterCategories.map((category, index) => (
        <li class="filter-item">
          <button
            class={`text-light-gray text-[length:var(--fs-5)] transition-colors duration-[250ms] ease hover:text-light-gray-70${index === 0 ? ' active' : ''}`}
            data-filter-btn
          >
            {category}
          </button>
        </li>
      ))}
    </ul>

    <!-- Mobile filter -->
    <div class="filter-select-box relative mb-[25px] lg:hidden">
      <button
        class="filter-select bg-eerie-black-2 text-light-gray flex justify-between items-center w-full px-4 py-3 border border-jet rounded-[14px] text-[length:var(--fs-6)] font-light"
        data-select
      >
        <div class="select-value" data-selecct-value>All</div>
        <div class="select-icon">
          <ion-icon name="chevron-down"></ion-icon>
        </div>
      </button>
      <ul
        class="select-list bg-eerie-black-2 absolute top-[calc(100%+6px)] w-full p-[6px] border border-jet rounded-[14px] z-[2] opacity-0 invisible pointer-events-none transition-all duration-150 ease-in-out"
      >
        {filterCategories.map((category) => (
          <li class="select-item">
            <button
              class="bg-eerie-black-2 text-light-gray text-[length:var(--fs-6)] font-light capitalize w-full px-2.5 py-2 rounded-lg"
              data-select-item
            >
              {category}
            </button>
          </li>
        ))}
      </ul>
    </div>

    <!-- Project list -->
    <ul class="project-list grid grid-cols-1 gap-[30px] mb-[10px] lg:grid-cols-2 xl:grid-cols-3">
      {projects.map((project) => (
        <li
          class="project-item active hidden"
          data-filter-item
          data-category={project.category}
        >
          <a href={project.url} class="group w-full" target="_blank" rel="noopener noreferrer">
            <figure
              class="project-img relative w-full h-[200px] rounded-[16px] overflow-hidden mb-[15px] xl:h-[175px]
                     before:content-[''] before:absolute before:inset-0 before:bg-transparent before:z-[1]
                     before:transition-all before:duration-[250ms] before:ease
                     group-hover:before:bg-black/50"
            >
              <div
                class="project-item-icon-box absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 scale-[0.8]
                       bg-jet text-orange-yellow-crayola text-[20px] p-[18px] rounded-[12px] opacity-0 z-[1]
                       transition-all duration-[250ms] ease group-hover:scale-100 group-hover:opacity-100"
              >
                <ion-icon name="eye-outline" class="[--ionicon-stroke-width:50px]"></ion-icon>
              </div>
              <img
                src={project.image.src}
                alt={project.title.toLowerCase()}
                loading="lazy"
                class="w-full h-full object-cover transition-all duration-[250ms] ease group-hover:scale-110"
              />
            </figure>
            <h3 class="project-title text-white-2 text-[length:var(--fs-5)] font-normal leading-[1.3] ml-[10px]">
              {project.title}
            </h3>
            <p class="project-category text-light-gray-70 text-[length:var(--fs-6)] font-light ml-[10px]">
              {project.category}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</article>

<style>
  /* Filter button active state */
  .filter-item button.active {
    color: var(--color-orange-yellow-crayola);
  }

  /* Mobile filter — select icon rotation */
  .filter-select.active .select-icon {
    transform: rotate(0.5turn);
  }

  /* Mobile filter — dropdown visibility */
  .filter-select.active + .select-list {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  /* Select item hover — CSS variable override for background darkening */
  .select-item button:hover {
    --color-eerie-black-2: hsl(240, 2%, 20%);
  }

  /* Project item show/hide with animation */
  .project-item.active {
    display: block;
    animation: scaleUp 0.25s ease forwards;
  }
</style>

<script>
  // Portfolio filter
  const select = document.querySelector<HTMLElement>('[data-select]');
  const selectItems = document.querySelectorAll<HTMLElement>('[data-select-item]');
  const selectValue = document.querySelector<HTMLElement>('[data-selecct-value]');
  const filterBtn = document.querySelectorAll<HTMLElement>('[data-filter-btn]');
  const filterItems = document.querySelectorAll<HTMLElement>('[data-filter-item]');

  function filterFunc(selectedValue: string) {
    filterItems.forEach((item) => {
      if (selectedValue === 'all') {
        item.classList.add('active');
      } else if (selectedValue === item.dataset.category?.toLowerCase()) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }
    });
  }

  if (select) {
    select.addEventListener('click', function (this: HTMLElement) {
      this.classList.toggle('active');
    });
  }

  selectItems.forEach((item) => {
    item.addEventListener('click', function (this: HTMLElement) {
      const selectedValue = this.innerText.toLowerCase();
      if (selectValue) selectValue.innerText = this.innerText;
      if (select) select.classList.toggle('active');
      filterFunc(selectedValue);
    });
  });

  let lastClickedBtn: HTMLElement | undefined = filterBtn[0];
  filterBtn.forEach((btn) => {
    btn.addEventListener('click', function (this: HTMLElement) {
      const selectedValue = this.innerText.toLowerCase();
      if (selectValue) selectValue.innerText = this.innerText;
      filterFunc(selectedValue);

      if (lastClickedBtn) lastClickedBtn.classList.remove('active');
      this.classList.add('active');
      lastClickedBtn = this;
    });
  });
</script>