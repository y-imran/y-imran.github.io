---
interface Item {
  icon: string;
  title: string;
  detail?: string;
}

interface Props {
  dataRows?: string[];
  destinations?: Item[];
  caption?: string;
}

const { dataRows = [], destinations = [], caption } = Astro.props;
---

<figure class="my-5">
  <div class="w-full rounded-[10px] border border-jet bg-eerie-black-1 p-4 md:p-6">
    <div class="flex flex-col xl:flex-row xl:items-stretch gap-4 xl:gap-2">

      {/* Clean data from Transform */}
      <div class="xl:flex-1 min-w-0 flex flex-col">
        <p class="min-h-[2.5rem] text-[11px] uppercase tracking-[0.18em] text-light-gray-70 mb-2">
          From Transform — clean data
        </p>
        <div class="flex-1 rounded-[8px] border border-jet bg-onyx p-3">
          <div class="flex items-center gap-2 text-light-gray">
            <ion-icon name="checkmark-circle-outline" aria-hidden="true" class="text-[18px]"></ion-icon>
            <span class="text-xs font-semibold uppercase tracking-[0.15em]">Clean rows</span>
          </div>

          <div class="mt-3 space-y-1.5 font-mono text-[11px] sm:text-xs text-light-gray-70">
            {dataRows.map((row) => <p class="whitespace-nowrap">{row}</p>)}
          </div>

          <p class="mt-3 xl:mt-auto text-[10px] italic text-light-gray-70">
            Duplicates gone. Values consistent.
          </p>
        </div>
      </div>

      {/* Arrow */}
      <div class="flex justify-center items-center text-orange-yellow-crayola xl:px-1 shrink-0">
        <ion-icon name="arrow-down-outline" aria-hidden="true" class="text-[22px] xl:hidden"></ion-icon>
        <ion-icon name="arrow-forward-outline" aria-hidden="true" class="text-[22px] hidden xl:block"></ion-icon>
      </div>

      {/* Load */}
      <div class="xl:flex-[1.1] min-w-0 flex flex-col">
        <p class="min-h-[2.5rem] text-[11px] uppercase tracking-[0.18em] text-light-gray-70 mb-2">
          Load — Write the data to the destination
        </p>
        <div class="flex-1 rounded-[8px] border border-vegas-gold/40 bg-onyx p-3">
          <div class="flex items-center gap-2 text-vegas-gold">
            <ion-icon name="cloud-upload-outline" aria-hidden="true" class="text-[18px]"></ion-icon>
            <span class="text-xs font-semibold uppercase tracking-[0.15em]">Load</span>
          </div>

          <p class="mt-2 text-light-gray text-xs md:text-sm leading-[1.45]">
            The clean rows are written into the destination, exactly as Transform produced them.
          </p>

          <p class="mt-3 xl:mt-auto rounded-[6px] border border-jet bg-eerie-black-1 px-2.5 py-2 text-[11px] leading-[1.5] text-light-gray-70">
            That is all Load does:
            <span class="text-light-gray">put the prepared data where it can be used.</span>
          </p>
        </div>
      </div>

      {/* Arrow */}
      <div class="flex justify-center items-center text-orange-yellow-crayola xl:px-1 shrink-0">
        <ion-icon name="arrow-down-outline" aria-hidden="true" class="text-[22px] xl:hidden"></ion-icon>
        <ion-icon name="arrow-forward-outline" aria-hidden="true" class="text-[22px] hidden xl:block"></ion-icon>
      </div>

      {/* Destination */}
      <div class="xl:flex-[1.1] min-w-0 flex flex-col">
        <p class="min-h-[2.5rem] text-[11px] uppercase tracking-[0.18em] text-light-gray-70 mb-2">
          Destination — where the data lives
        </p>
        <div class="flex-1 rounded-[8px] border border-jet bg-onyx p-3">
          <div class="flex items-center gap-2 text-light-gray">
            <ion-icon name="server-outline" aria-hidden="true" class="text-[18px]"></ion-icon>
            <span class="text-xs font-semibold uppercase tracking-[0.15em]">Stored</span>
          </div>

          <div class="mt-3 space-y-2">
            {destinations.map((destination) => (
              <div class="flex items-start gap-2">
                <ion-icon
                  name={destination.icon}
                  aria-hidden="true"
                  class="shrink-0 mt-0.5 text-vegas-gold text-[14px]"
                ></ion-icon>
                <div class="min-w-0">
                  <p class="text-light-gray text-xs font-medium leading-[1.3]">{destination.title}</p>
                  {destination.detail && (
                    <p class="text-light-gray-70 text-[11px] leading-[1.4]">{destination.detail}</p>
                  )}
                </div>
              </div>
            ))}
          </div>

          <p class="mt-3 xl:mt-auto text-[10px] italic text-light-gray-70">
            Ready for SQL, reports and dashboards.
          </p>
        </div>
      </div>

    </div>
  </div>

  {caption && (
    <figcaption class="text-light-gray-70 text-xs md:text-sm font-[var(--fw-300)] text-center font-sans italic mt-3">
      {caption}
    </figcaption>
  )}
</figure>
