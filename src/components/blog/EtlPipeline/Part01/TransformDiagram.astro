---
interface Step {
  title: string;
  detail?: string;
}

interface Props {
  headers: string[];
  beforeRows: string[][];
  afterRows: string[][];
  steps: Step[];
  caption?: string;
}

const { headers, beforeRows, afterRows, steps, caption } = Astro.props;

const shortHeader = (header: string) => header.replace(/^customer_/, '');

const idCounts = new Map<string, number>();
for (const row of beforeRows) {
  idCounts.set(row[0], (idCounts.get(row[0]) ?? 0) + 1);
}
const isDuplicate = (row: string[]) => (idCounts.get(row[0]) ?? 0) > 1;

const MISSING = new Set(['', 'null', 'NULL', 'N/A', '-']);

function isProblemCell(headers: string[], col: number, value: string): boolean {
  const header = (headers[col] ?? '').toLowerCase();
  if (header.includes('city')) {
    const titleCase = value.charAt(0).toUpperCase() + value.slice(1).toLowerCase();
    return value !== titleCase;
  }
  if (header.includes('email')) {
    return MISSING.has(value.trim());
  }
  return false;
}

function afterChanged(row: string[], col: number): boolean {
  return beforeRows
    .filter((candidate) => candidate[0] === row[0])
    .some((candidate) => candidate[col] !== row[col]);
}

const isBlank = (value: string) => value.trim() === '';
const displayValue = (value: string) => (isBlank(value) ? "''" : value);

const warn = 'text-[hsl(45,96%,64%)]';
---

<figure class="my-5">
  <div class="w-full rounded-[10px] border border-jet bg-eerie-black-1 p-4 md:p-6">

    {/* Before */}
    <div class="rounded-[8px] border border-jet bg-onyx p-3">
      <p class="text-[11px] uppercase tracking-[0.18em] text-light-gray-70 mb-2">
        Before — raw copy from Extract
      </p>

      {/* Desktop / tablet */}
      <div class="hidden sm:block">
        <div class="record-grid px-1 pb-1.5 text-[10px] uppercase tracking-[0.06em] text-light-gray-70">
          {headers.map((header) => <span class="truncate">{shortHeader(header)}</span>)}
        </div>

        {beforeRows.map((row) => (
          <div
            class={`record-grid px-1 py-1.5 border-t border-jet/60 text-xs ${
              isDuplicate(row) ? 'bg-[hsla(45,96%,55%,0.08)]' : ''
            }`}
          >
            {row.map((cell, col) => (
              <span class={`truncate ${isProblemCell(headers, col, cell) ? warn : 'text-light-gray'}`}>
                {displayValue(cell)}
              </span>
            ))}
          </div>
        ))}
      </div>

      {/* Mobile: one record per block, no columns to squeeze */}
      <div class="sm:hidden">
        {beforeRows.map((row) => (
          <div
            class={`px-1 py-2 border-t border-jet/60 font-mono ${
              isDuplicate(row) ? 'bg-[hsla(45,96%,55%,0.08)]' : ''
            }`}
          >
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs text-light-gray">{row[0]} · {row[1]}</span>
            </div>
            <div class="flex items-center justify-between gap-2 mt-0.5 text-[11px]">
              <span class={isProblemCell(headers, 2, row[2] ?? '') ? warn : 'text-light-gray-70'}>
                {row[2]}
              </span>
              <span class={isProblemCell(headers, 3, row[3] ?? '') ? warn : 'text-light-gray-70'}>
                {displayValue(row[3] ?? '')}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="flex justify-center py-2 text-orange-yellow-crayola">
      <ion-icon name="arrow-down-outline" aria-hidden="true" class="text-[20px]"></ion-icon>
    </div>

    {/* Transform */}
    <div class="rounded-[8px] border border-vegas-gold/40 bg-onyx p-3">
      <div class="flex items-center justify-center gap-2 text-vegas-gold">
        <ion-icon name="construct-outline" aria-hidden="true" class="text-[18px]"></ion-icon>
        <span class="text-xs font-semibold uppercase tracking-[0.15em]">Transform</span>
      </div>

      <div class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-2">
        {steps.map((step, index) => (
          <div class="rounded-[6px] border border-jet bg-eerie-black-1 px-2.5 py-2">
            <p class="text-light-gray text-xs font-medium leading-[1.35]">
              <span class="text-vegas-gold">{index + 1}.</span> {step.title}
            </p>
            {step.detail && (
              <p class="text-light-gray-70 text-[11px] leading-[1.45] mt-0.5">{step.detail}</p>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="flex justify-center py-2 text-orange-yellow-crayola">
      <ion-icon name="arrow-down-outline" aria-hidden="true" class="text-[20px]"></ion-icon>
    </div>

    {/* After */}
    <div class="rounded-[8px] border border-jet bg-onyx p-3">
      <p class="text-[11px] uppercase tracking-[0.18em] text-light-gray-70 mb-2">
        After — analysis-ready data
      </p>

      {/* Desktop / tablet */}
      <div class="hidden sm:block">
        <div class="record-grid px-1 pb-1.5 text-[10px] uppercase tracking-[0.06em] text-light-gray-70">
          {headers.map((header) => <span class="truncate">{shortHeader(header)}</span>)}
        </div>

        {afterRows.map((row) => (
          <div class="record-grid px-1 py-1.5 border-t border-jet/60 text-xs">
            {row.map((cell, col) => (
              <span class={`truncate ${afterChanged(row, col) ? '-mx-1 rounded-[3px] bg-vegas-gold/10 px-1 text-vegas-gold' : 'text-light-gray'}`}>
                {cell}
              </span>
            ))}
          </div>
        ))}
      </div>

      {/* Mobile */}
      <div class="sm:hidden">
        {afterRows.map((row) => (
          <div class="px-1 py-2 border-t border-jet/60 font-mono">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs text-light-gray">{row[0]} · {row[1]}</span>
            </div>
            <div class="flex items-center justify-between gap-2 mt-0.5 text-[11px]">
              <span class={afterChanged(row, 2) ? '-mx-1 rounded-[3px] bg-vegas-gold/10 px-1 text-vegas-gold' : 'text-light-gray-70'}>
                {row[2]}
              </span>
              <span class={afterChanged(row, 3) ? '-mx-1 rounded-[3px] bg-vegas-gold/10 px-1 text-vegas-gold' : 'text-light-gray-70'}>
                {row[3]}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>

  {caption && (
    <figcaption class="text-light-gray-70 text-xs md:text-sm font-[var(--fw-300)] text-center font-sans italic mt-3">
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .record-grid {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1.9fr);
    column-gap: 0.75rem;
    align-items: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
</style>
