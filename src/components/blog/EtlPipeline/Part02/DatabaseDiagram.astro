---
interface Column {
  name: string;
}

interface Table {
  name: string;
  file: string;
  columns: Column[];
}

interface Props {
  title?: string;
  caption?: string;
}

const {
  title,
  caption = 'The four tables in the e-commerce dataset, with their columns.',
} = Astro.props;

/*-----------------------------------*\
  #SCHEMA
\*-----------------------------------*/

const tables: Table[] = [
  {
    name: 'customers',
    file: 'customers.csv',
    columns: [
      { name: 'customer_id' },
      { name: 'customer_name' },
      { name: 'email' },
      { name: 'city' },
    ],
  },
  {
    name: 'orders',
    file: 'orders.csv',
    columns: [
      { name: 'order_id' },
      { name: 'customer_id' },
      { name: 'order_date' },
      { name: 'status' },
      { name: 'created_at' },
      { name: 'updated_at' },
    ],
  },
  {
    name: 'products',
    file: 'products.csv',
    columns: [
      { name: 'product_id' },
      { name: 'product_name' },
      { name: 'category' },
      { name: 'price' },
    ],
  },
  {
    name: 'order_items',
    file: 'order_items.csv',
    columns: [
      { name: 'order_item_id' },
      { name: 'order_id' },
      { name: 'product_id' },
      { name: 'quantity' },
    ],
  },
];

const iconPaths: Record<string, string[]> = {
  customers: [
    'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
    'M4 21c0-4 3.6-7 8-7s8 3 8 7',
  ],
  orders: [
    'M6 3h12v18l-3-2-3 2-3-2-3 2V3Z',
    'M9 8h6M9 12h6M9 16h4',
  ],
  products: [
    'M12 3 3 8v8l9 5 9-5V8l-9-5Z',
    'M3 8l9 5 9-5M12 13v8',
  ],
  order_items: [
    'M9 6h12M9 12h12M9 18h12',
    'M4.5 6h.01M4.5 12h.01M4.5 18h.01',
  ],
};

/*-----------------------------------*\
  #GEOMETRY
\*-----------------------------------*/

const CARD_W = 160;
const HEADER_H = 46;
const ROW_H = 24;
const CARD_PAD_TOP = 12;
const CARD_PAD_BOTTOM = 10;
const GAP_X = 12;
const MARGIN = 14;

const ROWS = Math.max(...tables.map((table) => table.columns.length));
const CARD_H = HEADER_H + CARD_PAD_TOP + ROWS * ROW_H + CARD_PAD_BOTTOM;

const positions = tables.map((_, index) => ({
  x: MARGIN + index * (CARD_W + GAP_X),
  y: MARGIN,
}));

const VIEW_W = MARGIN * 2 + CARD_W * tables.length + GAP_X * (tables.length - 1);
const VIEW_H = MARGIN * 2 + CARD_H;
const uid = `erd-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="mx-auto my-5 max-w-[960px]">
  <div class="w-full rounded-[10px] border border-jet bg-eerie-black-1 p-4 md:p-5">

    {title && (
      <p class="text-center text-light-gray text-sm md:text-base font-medium leading-[1.4] mb-4">
        {title}
      </p>
    )}

    <div class="-mx-1 overflow-x-auto px-1 pb-1">
      <svg
        viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
        class="erd block h-auto w-full min-w-[580px]"
        role="img"
        aria-labelledby={`${uid}-title ${uid}-desc`}
      >
        <title id={`${uid}-title`}>The e-commerce database tables</title>
        <desc id={`${uid}-desc`}>
          Four tables: customers, orders, products and order_items, with their columns.
        </desc>

        <defs>
          <linearGradient id={`${uid}-head`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="hsla(192, 85%, 47%, 0.20)" />
            <stop offset="100%" stop-color="hsla(192, 85%, 47%, 0.03)" />
          </linearGradient>
        </defs>

        {tables.map((table, index) => {
          const { x, y } = positions[index];

          return (
            <g>
              <rect
                x={x}
                y={y}
                width={CARD_W}
                height={CARD_H}
                rx="12"
                fill="var(--color-onyx)"
                stroke="var(--color-jet)"
                stroke-width="1"
              />

              <path
                d={`M ${x} ${y + 12}
                    Q ${x} ${y} ${x + 12} ${y}
                    H ${x + CARD_W - 12}
                    Q ${x + CARD_W} ${y} ${x + CARD_W} ${y + 12}
                    V ${y + HEADER_H}
                    H ${x}
                    Z`}
                fill={`url(#${uid}-head)`}
              />

              <line
                x1={x}
                y1={y + HEADER_H}
                x2={x + CARD_W}
                y2={y + HEADER_H}
                stroke="var(--color-jet)"
                stroke-width="1"
              />

              <g
                transform={`translate(${x + 12} ${y + 8}) scale(0.58)`}
                fill="none"
                stroke="var(--color-vegas-gold)"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {iconPaths[table.name]?.map((d) => <path d={d} />)}
              </g>

              <text
                x={x + 30}
                y={y + 18}
                fill="var(--color-white-2)"
                font-size="13"
                font-weight="600"
              >
                {table.name}
              </text>

              <text
                x={x + 30}
                y={y + 33}
                fill="var(--color-light-gray-70)"
                font-size="9"
                class="erd-mono"
              >
                {table.file}
              </text>

              {table.columns.map((column, rowIndex) => {
                const centerY = y + HEADER_H + CARD_PAD_TOP + rowIndex * ROW_H + ROW_H / 2;

                return (
                  <text
                    x={x + 14}
                    y={centerY + 4}
                    fill="var(--color-light-gray)"
                    font-size="12"
                  >
                    {column.name}
                  </text>
                );
              })}
            </g>
          );
        })}
      </svg>
    </div>

    <p class="mt-1 text-center text-[10px] italic text-light-gray-70 lg:hidden">
      Swipe horizontally to see all four tables
    </p>
  </div>

  {caption && (
    <figcaption class="text-light-gray-70 text-xs md:text-sm font-[var(--fw-300)] text-center font-sans italic mt-3">
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .erd {
    font-family: var(--ff-poppins), ui-sans-serif, system-ui, sans-serif;
  }

  .erd-mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
</style>
