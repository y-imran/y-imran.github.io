---
interface Column {
  name: string;
}

interface Table {
  name: string;
  file: string;
  columns: Column[];
}

interface Props {
  title?: string;
  caption?: string;
}

const {
  title,
  caption = 'The four tables in the e-commerce dataset, with their columns.',
} = Astro.props;

/*-----------------------------------*\
  #SCHEMA
\*-----------------------------------*/

const tables: Table[] = [
  {
    name: 'customers',
    file: 'customers.csv',
    columns: [
      { name: 'customer_id' },
      { name: 'customer_name' },
      { name: 'email' },
      { name: 'city' },
    ],
  },
  {
    name: 'orders',
    file: 'orders.csv',
    columns: [
      { name: 'order_id' },
      { name: 'customer_id' },
      { name: 'order_date' },
      { name: 'status' },
      { name: 'created_at' },
      { name: 'updated_at' },
    ],
  },
  {
    name: 'products',
    file: 'products.csv',
    columns: [
      { name: 'product_id' },
      { name: 'product_name' },
      { name: 'category' },
      { name: 'price' },
    ],
  },
  {
    name: 'order_items',
    file: 'order_items.csv',
    columns: [
      { name: 'order_item_id' },
      { name: 'order_id' },
      { name: 'product_id' },
      { name: 'quantity' },
    ],
  },
];

const iconPaths: Record<string, string[]> = {
  customers: [
    'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
    'M4 21c0-4 3.6-7 8-7s8 3 8 7',
  ],
  orders: [
    'M6 3h12v18l-3-2-3 2-3-2-3 2V3Z',
    'M9 8h6M9 12h6M9 16h4',
  ],
  products: [
    'M12 3 3 8v8l9 5 9-5V8l-9-5Z',
    'M3 8l9 5 9-5M12 13v8',
  ],
  order_items: [
    'M9 6h12M9 12h12M9 18h12',
    'M4.5 6h.01M4.5 12h.01M4.5 18h.01',
  ],
};
---

<figure class="mx-auto my-5 max-w-[960px]">
  <div class="w-full rounded-[10px] border border-jet bg-eerie-black-1 p-4 md:p-5">

    {title && (
      <p class="text-center text-light-gray text-sm md:text-base font-medium leading-[1.4] mb-4">
        {title}
      </p>
    )}

    <div class="grid auto-rows-fr grid-cols-2 gap-2 sm:gap-3 lg:grid-cols-4">
      {tables.map((table) => (
        <div class="flex h-full min-h-[190px] flex-col overflow-hidden rounded-[10px] border border-jet bg-onyx">
          <div class="card-head flex items-start gap-2 border-b border-jet px-3 py-2.5">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="mt-0.5 h-4 w-4 shrink-0 text-vegas-gold"
            >
              {iconPaths[table.name]?.map((d) => <path d={d} />)}
            </svg>

            <div class="min-w-0">
              <p class="truncate text-xs font-semibold leading-[1.35] text-white-2">
                {table.name}
              </p>
              <p class="truncate font-mono text-[9px] leading-[1.4] text-light-gray-70">
                {table.file}
              </p>
            </div>
          </div>

          <ul class="flex-1 px-3 py-2">
            {table.columns.map((column) => (
              <li class="text-xs leading-[1.8] text-light-gray">{column.name}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  {caption && (
    <figcaption class="text-light-gray-70 text-xs md:text-sm font-[var(--fw-300)] text-center font-sans italic mt-3">
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .card-head {
    background-image: linear-gradient(
      to bottom,
      hsla(192, 85%, 47%, 0.2),
      hsla(192, 85%, 47%, 0.03)
    );
  }
</style>
