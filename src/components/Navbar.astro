---
const navItems = [
  { label: 'Home', href: '/', icon: '/icons/home.svg' },
  { label: 'Resume', href: '/resume/', icon: '/icons/resume.svg' },
  { label: 'Portfolio', href: '/portfolio/', icon: '/icons/portfolio.svg' },
  { label: 'Blog', href: '/blog/', icon: '/icons/blog.svg' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav class="navbar">
  <ul class="navbar-list">
    {navItems.map((item) => (
      <li class="navbar-item">
        <a href={item.href} class={`navbar-link${isActive(item.href) ? ' active' : ''}`}>
          <span class="navbar-icon" style={`mask-image: url('${item.icon}'); -webkit-mask-image: url('${item.icon}');`}></span>
          <span class="navbar-text">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>