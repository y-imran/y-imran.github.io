---
import about from '@src/data/about.ts';
---

<article class="about active" data-page="home">
  <header>
    <p class="hero-subtitle text-light-gray-70 text-[length:var(--fs-6)] font-light mb-1">Welcome</p>
    <h1 class="h1 article-title mb-[15px] md:mb-[20px]">I'm Yusra Imran</h1>
  </header>

  <section class="about-text text-light-gray text-[length:var(--fs-6)] font-light leading-[1.6] md:mb-[40px]">
    {about.paragraphs.map((paragraph) => <p class="mb-[15px]">{paragraph}</p>)}
  </section>
</article>