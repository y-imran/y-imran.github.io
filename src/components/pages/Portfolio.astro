---
import portfolios, { PortfolioCategory } from '@data/portfolio.ts';
import FilterControls from '@components/ui/common/FilterControls.astro';

const filterCategories = ['All', ...Object.values(PortfolioCategory)];
---

<article class="portfolio active" data-page="portfolio">
  <header>
    <h2 class="h2 article-title mb-[30px]">Portfolio</h2>
  </header>

  <section class="portfolios">
    <FilterControls categories={filterCategories} />

    <ul class="portfolio-list grid grid-cols-1 gap-[30px] mb-[10px] lg:grid-cols-2 xl:grid-cols-3">
      {portfolios.map((portfolio) => (
        <li
          class="portfolio-item active hidden"
          data-filter-item
          data-category={portfolio.category}
        >
          <a href={portfolio.url} class="group w-full" target="_blank" rel="noopener noreferrer">
            <figure
              class="portfolio-img relative w-full h-[200px] rounded-[16px] overflow-hidden mb-[15px] xl:h-[175px]
                     before:content-[''] before:absolute before:inset-0 before:bg-transparent before:z-[1]
                     before:transition-all before:duration-[250ms] before:ease
                     group-hover:before:bg-black/50"
            >
              <div
                class="portfolio-item-icon-box absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 scale-[0.8]
                       bg-jet text-orange-yellow-crayola text-[20px] p-[18px] rounded-[12px] opacity-0 z-[1]
                       transition-all duration-[250ms] ease group-hover:scale-100 group-hover:opacity-100"
              >
                <ion-icon name="eye-outline" class="[--ionicon-stroke-width:50px]"></ion-icon>
              </div>
              <img
                src={portfolio.image.src}
                alt={portfolio.title.toLowerCase()}
                loading="lazy"
                class="w-full h-full object-cover transition-all duration-[250ms] ease group-hover:scale-110"
              />
            </figure>
            <h3 class="portfolio-title text-white-2 text-[length:var(--fs-5)] font-normal leading-[1.3] ml-[10px]">
              {portfolio.title}
            </h3>
            <p class="portfolio-category text-light-gray-70 text-[length:var(--fs-6)] font-light ml-[10px]">
              {portfolio.category}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</article>

<style>
  .portfolio-item.active {
    display: block;
    animation: scaleUp 0.25s ease forwards;
  }
</style>
