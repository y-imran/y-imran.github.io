---
import about from '@data/about.ts';
import certifications from '@data/certification.ts';
import tableauVisualizations from '@data/tableau-visualizations.ts';
import Certification from '@components/ui/home/Certification.astro';
import TableauVisualizationTimeline from '@components/ui/tableau/TableauVisualizationTimeline.astro';
---

<article class="about active" data-page="home">
  <header>
    <p class="hero-subtitle text-light-gray-70 text-[length:var(--fs-4)] font-light mb-1">Welcome</p>
    <h1 class="h1 article-title mb-[15px] md:mb-[20px]"><span class="font-normal inline">I'm</span> <span class="font-black inline">Yusra Imran</span></h1>
  </header>

  <section class="about-text text-light-gray text-[length:var(--fs-6)] font-light leading-[1.6] md:mb-[40px]">
    {about.paragraphs.map((paragraph) => <p class="mb-[15px]">{paragraph}</p>)}
  </section>

  <Certification certifications={certifications} />

  <TableauVisualizationTimeline visualizations={tableauVisualizations} />
</article>