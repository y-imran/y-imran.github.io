---
interface Dashboard {
  slug: string;
  title: string;
  description: string;
  dataset: string;
  competition?: string;
}

const dashboards: Dashboard[] = [];
---

<article class="dashboard active" data-page="dashboard">
  <header>
    <h2 class="h2 article-title mb-[30px]">Dashboards</h2>
  </header>

  <section class="dashboards">
    {dashboards.length > 0 && (
    <ul class="dashboard-list grid grid-cols-1 gap-[30px] mb-[10px] lg:grid-cols-2 xl:grid-cols-3">
      {dashboards.map((dashboard) => (
        <li class="dashboard-item">
          <a href={`/dashboard/${dashboard.slug}/`} class="group w-full block">
            <figure
              class="relative w-full h-[180px] rounded-[16px] overflow-hidden mb-[15px] bg-eerie-black-1 border border-jet flex items-center justify-center"
            >
              <ion-icon name="bar-chart-outline" class="text-[36px] text-light-gray-70"></ion-icon>
            </figure>
            <h3 class="text-white-2 text-[length:var(--fs-5)] font-normal leading-[1.3] ml-[10px]">
              {dashboard.title}
            </h3>
            <p class="text-light-gray text-[length:var(--fs-6)] font-light ml-[10px] mb-[5px]">
              {dashboard.description}
            </p>
            <p class="text-light-gray-70 text-[length:var(--fs-7)] font-light ml-[10px]">
              {dashboard.dataset}
              {dashboard.competition && ` · ${dashboard.competition}`}
            </p>
          </a>
        </li>
      ))}
    </ul>
    )}
  </section>
</article>
