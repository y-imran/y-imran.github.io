---
import { Image } from 'astro:assets';
import dashboards from '@data/dashboards.ts';
import FilterControls from '@components/ui/common/FilterControls.astro';

const filterCategories = ['All', ...new Set(dashboards.map((dashboard) => dashboard.competition))];
---

<article class="dashboard active" data-page="dashboard">
  <header>
    <h2 class="h2 article-title mb-[30px]">Dashboards</h2>
  </header>

  <section class="dashboards">
    {
      dashboards.length > 0 && (
        <>
          <FilterControls categories={filterCategories} />

          <ul class="dashboard-list grid grid-cols-1 gap-[30px] mb-[10px] lg:grid-cols-2 xl:grid-cols-3">
            {dashboards.map((dashboard) => (
              <li
                class="dashboard-item active hidden"
                data-filter-item
                data-category={dashboard.competition}
              >
                <a href={dashboard.url} class="group w-full block">
                  <figure
                    class="relative w-full h-[180px] rounded-[16px] overflow-hidden mb-[15px] bg-eerie-black-1 border border-jet
                           before:content-[''] before:absolute before:inset-0 before:bg-transparent before:z-[1]
                           before:transition-all before:duration-[250ms] before:ease
                           group-hover:before:bg-black/50"
                  >
                    <div
                      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 scale-[0.8]
                             bg-jet text-orange-yellow-crayola text-[20px] p-[18px] rounded-[12px] opacity-0 z-[1]
                             transition-all duration-[250ms] ease group-hover:scale-100 group-hover:opacity-100"
                    >
                      <ion-icon name="eye-outline" class="[--ionicon-stroke-width:50px]"></ion-icon>
                    </div>
                    <Image
                      src={dashboard.thumbnail}
                      alt={dashboard.title}
                      width={600}
                      height={375}
                      loading="lazy"
                      class="w-full h-full object-cover transition-all duration-[250ms] ease group-hover:scale-110"
                    />
                  </figure>
                  <h3 class="text-white-2 text-[length:var(--fs-5)] font-normal leading-[1.3] ml-[10px]">
                    {dashboard.title}
                  </h3>
                  <p class="text-light-gray text-[length:var(--fs-6)] font-light ml-[10px] mb-[5px]">
                    {dashboard.description}
                  </p>
                  <p class="text-light-gray-70 text-[length:var(--fs-7)] font-light ml-[10px]">
                    {dashboard.competition}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</article>

<style>
  .dashboard-item.active {
    display: block;
    animation: scaleUp 0.25s ease forwards;
  }
</style>
