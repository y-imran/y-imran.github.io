{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@src/*": ["./src/*"],
      "@portfolio/*": ["./src/assets/portfolio/*"],
      "@blog/*": ["./src/assets/blog/*"],
      "@components/*": ["./src/components/*"]
    }
  }
}
